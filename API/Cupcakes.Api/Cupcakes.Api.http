@baseUrl = http://127.0.0.1:5080

POST {{baseUrl}}/api/admin/products
Content-Type: application/json
X-XSRF-TOKEN: SUBSTITUA_PELO_REQUEST_TOKEN

{
  "name": "Cupcake demonstrativo",
  "flavor": "Chocolate",
  "description": "Produto ficticio cadastrado pela administracao.",
  "imagePath": "/images/products/cupcake.svg",
  "price": 15.50,
  "promotionalPrice": 12.90,
  "stock": 7
}

### Catalogo publico: produtos ativos, valores em BRL e disponibilidade
GET {{baseUrl}}/api/products
Accept: application/json

GET {{baseUrl}}/api/products?flavor=Chocolate&minPrice=10&maxPrice=15&onPromotion=true
Accept: application/json

GET {{baseUrl}}/api/products?onPromotion=false
Accept: application/json

GET {{baseUrl}}/api/products?minPrice=20&maxPrice=10
Accept: application/json


GET {{baseUrl}}/api/auth/antiforgery
Accept: application/json

# @name register
POST {{baseUrl}}/api/auth/register
Content-Type: application/json
X-XSRF-TOKEN: SUBSTITUA_PELO_REQUEST_TOKEN

{
  "email": "cliente@example.invalid",
  "password": "CupcakeTeste123"
}

POST {{baseUrl}}/api/auth/login
Content-Type: application/json
X-XSRF-TOKEN: SUBSTITUA_PELO_REQUEST_TOKEN

{
  "email": "cliente@example.invalid",
  "password": "CupcakeTeste123"
}

GET {{baseUrl}}/api/auth/antiforgery
Accept: application/json

GET {{baseUrl}}/api/auth/me
Accept: application/json

GET {{baseUrl}}/api/cart
Accept: application/json

POST {{baseUrl}}/api/cart/items
Content-Type: application/json
X-XSRF-TOKEN: SUBSTITUA_PELO_REQUEST_TOKEN_APOS_LOGIN

{
  "productId": "b8b95c22-a515-4f4b-a750-57343a6b0101",
  "quantity": 2
}

PUT {{baseUrl}}/api/cart/items/b8b95c22-a515-4f4b-a750-57343a6b0101
Content-Type: application/json
X-XSRF-TOKEN: SUBSTITUA_PELO_REQUEST_TOKEN_APOS_LOGIN

{
  "quantity": 1
}

### Remover item
DELETE {{baseUrl}}/api/cart/items/b8b95c22-a515-4f4b-a750-57343a6b0101
X-XSRF-TOKEN: SUBSTITUA_PELO_REQUEST_TOKEN_APOS_LOGIN

POST {{baseUrl}}/api/checkout/preview
Content-Type: application/json
X-XSRF-TOKEN: SUBSTITUA_PELO_REQUEST_TOKEN_APOS_LOGIN

{
  "address": {
    "recipient": "Pessoa Ficticia",
    "street": "Rua de Teste",
    "number": "s/n",
    "neighborhood": "Bairro Demonstrativo",
    "city": "Cidade de Teste",
    "state": "SP",
    "postalCode": "01234567",
    "complement": null
  }
}

POST {{baseUrl}}/api/checkout/confirm
Content-Type: application/json
X-XSRF-TOKEN: SUBSTITUA_PELO_REQUEST_TOKEN_APOS_LOGIN

{
  "confirmationId": "d788ab2e-0181-498a-93fd-c1c1259d6633",
  "address": {
    "recipient": "Pessoa Ficticia",
    "street": "Rua de Teste",
    "number": "s/n",
    "neighborhood": "Bairro Demonstrativo",
    "city": "Cidade de Teste",
    "state": "SP",
    "postalCode": "01234567",
    "complement": null
  },
  "paymentMethod": "Pix",
  "simulation": "Aprovar",
  "expectedItems": [
    {
      "productId": "b8b95c22-a515-4f4b-a750-57343a6b0101",
      "quantity": 1,
      "price": 12.50,
      "effectivePrice": 12.50
    }
  ]
}

GET {{baseUrl}}/api/orders
Accept: application/json

GET {{baseUrl}}/api/orders/00000000-0000-0000-0000-000000000000
Accept: application/json

### Encerrar sessao

POST {{baseUrl}}/api/auth/logout
X-XSRF-TOKEN: SUBSTITUA_PELO_REQUEST_TOKEN

### Processo da API
GET {{baseUrl}}/api/status
Accept: application/json

### Conectividade do PostgreSQL (200 disponivel, 503 indisponivel)
GET {{baseUrl}}/api/status/database
Accept: application/json

### Documento OpenAPI (Development)
GET {{baseUrl}}/openapi/v1.json
Accept: application/json
